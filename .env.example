# Database
DATABASE_URI=postgres://user:pass@127.0.0.1:5432/hotel-booking

# Payload
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public URLs (used in transactional emails and gateway callbacks)
APP_URL=http://localhost:3000
PARTNER_APP_URL=
ADMIN_APP_URL=

# Media storage (S3-compatible)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Search (Typesense)
TYPESENSE_HOST=127.0.0.1:8108
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# bKash
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_SECRET=

# Nagad
NAGAD_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_CALLBACK_URL=
NAGAD_PRIVATE_KEY_PATH=
NAGAD_PUBLIC_KEY_PATH=

# SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_MODE=sandbox

# AmarPay
AMARPAY_STORE_ID=
AMARPAY_SIGNATURE_KEY=
AMARPAY_MODE=sandbox

# SMS (Alpha SMS / sms.bd)
SMS_BD_API_KEY=
SMS_BD_SENDER_ID=
SMS_BD_BASE_URL=
SMS_BD_BALANCE_THRESHOLD=500

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=no-reply@mail.yoursite.com
RESEND_FROM_NAME=
RESEND_WEBHOOK_SECRET=

# Redis (OTP storage, rate limiting)
REDIS_URL=
